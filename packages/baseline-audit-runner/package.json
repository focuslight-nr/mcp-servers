{
  "name": "@focuslight-nr/checkpoint-baseline-audit-runner",
  "version": "0.1.0",
  "description": "Scheduled Check Point baseline audit orchestration runner",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "baseline-audit-runner": "dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/focuslight-nr/mcp-servers.git",
    "directory": "packages/baseline-audit-runner"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "build": "npm run build:bundle && npx shx chmod +x ./dist/index.js",
    "build:bundle": "node ../../bundle-mcp.js",
    "build:tsc": "npx tsc && npx shx chmod +x ./dist/index.js",
    "test": "npm run clean && npm run build:tsc && node --test dist/config.test.js dist/lock.test.js dist/notifier.test.js dist/workflow.test.js",
    "start": "node dist/index.js",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "commander": "^14.0.3",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "rimraf": "^6.0.1",
    "shx": "^0.3.4",
    "typescript": "^5.0.4"
  }
}
