{
  "name": "@focuslight-nr/checkpoint-gaia-readonly-collector-mcp",
  "version": "0.1.0",
  "description": "Non-interactive read-only Check Point Gaia collector MCP",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "gaia-readonly-collector-mcp": "dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/focuslight-nr/mcp-servers.git",
    "directory": "packages/gaia-readonly-collector"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "build": "npm run build:bundle && npx shx chmod +x ./dist/index.js",
    "build:bundle": "node ../../bundle-mcp.js",
    "build:tsc": "npx tsc && npx shx chmod +x ./dist/index.js",
    "test": "npm run clean && npm run build:tsc && node --test dist/credentials.test.js dist/gaia-client.test.js dist/service.test.js dist/mcp.integration.test.js",
    "start": "node dist/index.js",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "axios": "^1.20.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "rimraf": "^6.0.1",
    "shx": "^0.3.4",
    "typescript": "^5.0.4"
  }
}
