{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/focuslight-nr/mcp-servers/blob/main/packages/baseline-audit/schemas/baseline-format-v1.schema.json",
  "title": "Check Point Baseline Format v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "baseline", "controls"],
  "properties": {
    "$schema": { "type": "string" },
    "formatVersion": { "const": "1.0" },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "title"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "version": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "vendor": { "type": "string" },
        "platform": { "type": "string" }
      }
    },
    "inputs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[A-Za-z0-9._-]+$"
      }
    },
    "controls": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/control" }
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*$"
    },
    "value": {
      "oneOf": [
        { "type": ["string", "number", "boolean", "null"] },
        { "type": "array", "items": { "$ref": "#/$defs/value" } },
        {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/value" }
        }
      ]
    },
    "valueAssertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "operator"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "operator": {
          "enum": [
            "exists",
            "notExists",
            "equals",
            "notEquals",
            "contains",
            "minItems",
            "maxItems",
            "truthy"
          ]
        },
        "value": { "$ref": "#/$defs/value" },
        "valuePath": { "$ref": "#/$defs/path" },
        "caseInsensitive": { "type": "boolean" }
      }
    },
    "collectionAssertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "operator", "where"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "operator": { "enum": ["allMatch", "anyMatch", "noneMatch"] },
        "where": { "$ref": "#/$defs/assertion" },
        "evidencePath": { "$ref": "#/$defs/path" }
      }
    },
    "assertion": {
      "oneOf": [
        { "$ref": "#/$defs/valueAssertion" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["all"],
          "properties": {
            "all": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/assertion" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["any"],
          "properties": {
            "any": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/assertion" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["not"],
          "properties": { "not": { "$ref": "#/$defs/assertion" } }
        },
        { "$ref": "#/$defs/collectionAssertion" }
      ]
    },
    "remediation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action"],
      "properties": {
        "action": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "parameters": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/value" }
        }
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "expected", "assertion"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "severity": { "enum": ["low", "medium", "high", "critical"] },
        "expected": { "type": "string", "minLength": 1 },
        "assertion": { "$ref": "#/$defs/assertion" },
        "errorWhen": { "$ref": "#/$defs/assertion" },
        "manualWhen": { "$ref": "#/$defs/assertion" },
        "onMissing": { "enum": ["ERROR", "MANUAL", "FAIL"] },
        "remediation": { "$ref": "#/$defs/remediation" }
      }
    }
  }
}
