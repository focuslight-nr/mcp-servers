{
  "name": "@focuslight-nr/checkpoint-baseline-change-executor-mcp",
  "version": "0.1.0",
  "description": "Fake Gaia dry-run executor for approved baseline change plans",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    }
  },
  "bin": {
    "baseline-change-executor-mcp": "dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/focuslight-nr/mcp-servers.git",
    "directory": "packages/baseline-change-executor"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "build": "npm run build:bundle && npx shx chmod +x ./dist/index.js",
    "build:bundle": "node ../../bundle-mcp.js",
    "build:tsc": "npx tsc && npx shx chmod +x ./dist/index.js",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "npm run clean && npm run build:tsc && node --test dist/schema.test.js dist/executor.test.js dist/mcp.integration.test.js"
  },
  "dependencies": {
    "@focuslight-nr/checkpoint-baseline-change-planner-mcp": "0.1.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "rimraf": "^6.0.1",
    "shx": "^0.3.4",
    "typescript": "^5.0.4"
  }
}
