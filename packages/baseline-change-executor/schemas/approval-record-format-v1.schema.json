{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/focuslight-nr/mcp-servers/blob/main/packages/baseline-change-executor/schemas/approval-record-format-v1.schema.json",
  "title": "Check Point Approval Record Format v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "approval"],
  "properties": {
    "$schema": { "type": "string" },
    "formatVersion": { "const": "1.0" },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "planId",
        "planSha256",
        "changeIds",
        "decision",
        "approver",
        "approvedAt",
        "expiresAt",
        "reason",
        "provenanceReference"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "planId": { "$ref": "#/$defs/id" },
        "planSha256": { "$ref": "#/$defs/digest" },
        "changeIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "decision": { "enum": ["APPROVED", "REJECTED"] },
        "approver": {
          "type": "object",
          "additionalProperties": false,
          "required": ["subject", "issuer", "authentication"],
          "properties": {
            "subject": { "type": "string", "minLength": 1 },
            "displayName": { "type": "string", "minLength": 1 },
            "issuer": { "type": "string", "minLength": 1 },
            "authentication": { "const": "external-identity-provider" }
          }
        },
        "approvedAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "reason": { "type": "string", "minLength": 1 },
        "provenanceReference": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
