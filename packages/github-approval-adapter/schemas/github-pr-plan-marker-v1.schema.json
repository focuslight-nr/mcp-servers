{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/focuslight-nr/mcp-servers/blob/main/packages/github-approval-adapter/schemas/github-pr-plan-marker-v1.schema.json",
  "title": "GitHub Pull Request Change Plan Marker v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["planId", "planSha256", "changeIds"],
  "properties": {
    "planId": { "$ref": "#/$defs/id" },
    "planSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "changeIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._-]+$" }
  }
}
